    "feuille": ["feuille"],
    "date": ["etabli le", "dresse le", "edite le", "signe le", "fait le", "date", "fait a"],
    "echelle": ["echelle", "ech.", "ech"],
    "geometre": ["geometre expert", "cabinet", "dresse par", "geometre"],
