# ==========================================
# CONFIGURATION GEOFONCIER (API v2)
# ==========================================

# Environnement (sandbox ou production)
GEOFONCIER_ENV=sandbox

# Clé d'API (Généralement "Basic <base64>" ou "Bearer <token>")
GEOFONCIER_API_KEY=votre_cle_api_ici

# Identifiants de votre cabinet (obligatoires pour créer un dossier)
# 11 caractères (ex: SIRET ou ID Geofoncier)
GEOFONCIER_CAB_CREATEUR=00000000000
GEOFONCIER_CAB_DETENTEUR=00000000000

# Numéro d'inscription à l'Ordre du Géomètre-Expert créateur (5 chiffres)
GEOFONCIER_GE_CREATEUR=00000
